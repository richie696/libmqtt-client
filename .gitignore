# 构建目录
build/
build-*/
cmake-build-*/
third_party/*/build*/
third_party/*/build-*/

# Git Submodule 构建产物（wolfMQTT）
# 注意：Submodule 目录中的实际文件由 submodule 仓库管理
# 主仓库只提交 submodule 引用（在 .gitmodules 中），不提交 submodule 内容
# 用户克隆项目后，需要运行: git submodule update --init --recursive
# 或者运行初始化脚本: ./scripts/unix/init.sh 或 .\scripts\windows\init.ps1
#
# 排除 submodule 目录中的构建产物（Git 会自动处理 submodule 本身）
third_party/*/*

# CMake生成的文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt
!toolchains/*.cmake
compile_commands.json

# CMake FetchContent 生成的依赖目录
_deps/

# 编译产物
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# IDE文件
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.clangd/
.clang-format.bak

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Python相关
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
*.egg

# 日志和临时文件
*.log
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~

# 测试输出
Testing/
test-results/
coverage/
*.gcda
*.gcno
*.gcov

# 文档生成
docs/html/
docs/latex/
docs/man/

# 包管理
conan.lock
vcpkg_installed/

# 其他
*.user
*.suo
*.sdf
*.opensdf
*.db
*.opendb
